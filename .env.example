# GeoCrop local configuration. Copy to `.env` and fill in the values:
#   copy .env.example .env
# `.env` is git-ignored; never commit real credentials.

# ---- PostgreSQL (farmer profiles; read by geocrop/db.py) ---------------------
GEOCROP_DB_HOST=localhost
GEOCROP_DB_PORT=5433
GEOCROP_DB_NAME=geocrop
GEOCROP_DB_USER=geocrop
GEOCROP_DB_PASSWORD=change-me
# Least-privilege login the API runs as. Filled in automatically by:
#   .venv/Scripts/python scripts/db/create_app_role.py
# GEOCROP_DB_APP_USER=geocrop_app
# GEOCROP_DB_APP_PASSWORD=generated-by-the-script

# ---- API security (geocrop/api/security.py) ----------------------------------
# Web origins allowed to make write requests (comma-separated); default is the local dev server.
# GEOCROP_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Portable PostgreSQL binaries and data directory (used by scripts/db/*.cmd)
PGBIN=D:\geocrop_work\pgsql\bin
PGDATA=E:\projects\soil\db\pgdata

# ---- Optional overrides (defaults shown; see geocrop/config.py) --------------
# Scratch space for temp files and tile downloads (keep it off C:)
# GEOCROP_SCRATCH=D:\geocrop_work\tmp
# Google Earth Engine cloud project used by the downloaders
# GEOCROP_GEE_PROJECT=your-gee-project
# DataLoader workers for Plant Doctor training
# GEOCROP_WORKERS=2
